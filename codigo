"""
Exercício Pet

Instruções do Exercício

    1. Crie uma classe chamada Pet.
    2. A classe deve ter os seguintes atributos privados: _nome, _idade e _peso.
        - Utilize métodos "getters" para cada um desses atributos.
        - Utilize métodos "setters" para cada um desses atributos.

        Os "setters" devem conter as seguintes validações:
            - O nome deve ser uma string e não pode ser vazio.
            - A idade deve ser um número inteiro e deve ser maior ou igual a 0.
            - O peso deve ser um número flutuante e deve ser maior que 0.

    3. Adicione um método exibir_info() que mostre as informações do pet.


# Teste sua implementação
meu_pet = Pet()
meu_pet.set_nome("Buddy")
meu_pet.set_idade(5)
meu_pet.set_peso(9.5)
meu_pet.exibir_info()

Sua tarefa é completar a classe Pet seguindo as instruções.
Certifique-se de utilizar "getters" e "setters" para controlar o acesso aos
atributos da classe.
"""

class Pet:

    lista_pets = []

    def __init__(self,_nome: str, _idade : int, _peso: float):
        self._nome = _nome
        self._idade = _idade
        self._peso = _peso

    def get_nome(self):

        return self._nome

    def get_idade(self):

        return self._idade

    def get_peso(self):

        return round( self._peso,2)

    def set_nome(self,novo_nome):

        if not novo_nome.replace(' ','').isalpha():

            print('Nome invalido! Digite apenas letras')

            return

        self._nome = novo_nome

    def set_idade(self, nova_idade):

        if nova_idade <= 0:

            print('Numero invalido, digite um numero positivo')

            return

        self._idade = nova_idade

    def set_peso(self, novo_peso):

        if novo_peso <= 0:

            print('Numero invalido, digite um numero positivo')

            return

        self._peso = novo_peso

    @staticmethod
    def cadastrar():

        while True:

            _nome = str(input('Digite o nome: '))

            if not _nome.replace(' ','').isalpha():

                print('Nome invalido! Digite apenas o nome com letras')

            elif any(pet.get_nome().lower() == _nome.lower() for pet in Pet.lista_pets): #verifica se ja existe um pet com esse nome, para evitar duplicada de nomes

                print(f'Já existe um pet com o nome de {_nome}')

            else:

                print(f'Nome: {_nome} Adicionado com sucesso')

                break

        while True:

            try:

                _idade = int(input('Digite o idade: '))

                if _idade <=0:

                    print('Numero invalido, digite um numero positivo')
                else:

                    print(f'idade: {_idade} Adicionado com sucesso')

                    break

            except ValueError:

                print('Entrada invalida')

        while True:

            try:

                _peso = float(input('Digite o peso: '))

                if _peso <= 0:

                    print('Peso invalido, digite um peso positivo')

                else:

                    _peso = round(_peso,2)

                    print(f'peso: {_peso:.2f} kg adicionado com sucesso')

                    break

            except ValueError:

                print('Entrada invalida')

        pet = Pet (_nome, _idade, _peso)
        Pet.lista_pets.append(pet)

        return pet


    def exibir_info(self):

        print(f'Nome: {self._nome}')
        print(f'Idade: {self._idade} anos')
        print(f'Peso: {self._peso} kg')

    @staticmethod
    def procurar_nome(nome):

        if not Pet.lista_pets:

            print('nenhum Pet cadastrado')

            return

        for pet in Pet.lista_pets:

            if pet.get_nome().lower() == nome.lower():

                pet.exibir_info()

                return

        print(f'nome: {nome} não esta cadastrado')

    @staticmethod
    def procurar_peso(peso):

        if not Pet.lista_pets:

            print(f'Nenhum Pet cadastrado')

            return

        for pet in Pet.lista_pets:

            if pet.get_peso() == peso:

                pet.exibir_info()

                return

        print(f'Nenhum Pet com {peso} kg encontrado')

    @staticmethod
    def procurar_idade(idade):

        if not Pet.lista_pets:

            print('nenhum Pet cadastrado')

            return

        for pet in Pet.lista_pets:

            if pet.get_idade() == idade:

                pet.exibir_info()

                return

        print(f'Nenhum Pet com {idade} anos encontrado')

    def modificar_nome(self,novo_nome):

        if not novo_nome.replace(' ', '').isalpha():

            print('Nome invalido! Por favor digitar apenas letra')

            return

        self._nome = novo_nome

        print(f'Nome: {self._nome} modificado com sucesso.')

    def modificar_idade(self, nova_idade):

        if nova_idade <= 0:

            print('Numero invalido! Digite um numero maior que 0')

            return

        self._idade = nova_idade

        print(f'Idade : {self._idade} modificada com sucesso')

    def modificar_peso(self,novo_peso):

        if novo_peso <= 0:

            print('Numero invalido! Digite um numero maior que 0 ')

            return
        self._peso = round(novo_peso,2)

        print(f'Peso : {self._peso:.2f} modificado com sucesso')


